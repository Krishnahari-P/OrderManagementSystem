@model IEnumerable<Menu>
<ul class="navbar-nav flex-grow-1 justify-content-start">
    @if (User.Identity.IsAuthenticated)
    {
        foreach (var item in Model)
        {
            <li class="nav-item mx-1">
                <a class="nav-link text-dark fw-semibold rounded px-3 py-2 bg-light border border-1 border-secondary-subtle"
                   asp-controller="@item.Controller"
                   asp-action="@item.Action">
                    @item.DisplayName
                </a>
            </li>
        }
    }
</ul>



