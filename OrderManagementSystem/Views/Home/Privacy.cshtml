@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-black">
            <i class="fa-solid fa-user-shield me-2"></i> @ViewData["Title"]
        </h1>
        <p class="text-muted lead">
            Your privacy is important to us. Please read our policy below to understand how we handle your data.
        </p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="card-body">
                    <h4 class="fw-semibold text-dark mb-3">
                        <i class="fa-solid fa-lock me-2 text-primary"></i> Data Protection
                    </h4>
                    <p class="text-muted">
                        We are committed to protecting your personal information. Any data collected is used solely
                        for providing and improving the Order Management System experience.
                    </p>

                    <h4 class="fw-semibold text-dark mb-3 mt-4">
                        <i class="fa-solid fa-user-secret me-2 text-success"></i> Information We Collect
                    </h4>
                    <p class="text-muted">
                        We collect basic user details like name, email, and role information to manage system access.
                        Transaction data related to orders, payments, and suppliers is stored securely in our system.
                    </p>

                    <h4 class="fw-semibold text-dark mb-3 mt-4">
                        <i class="fa-solid fa-handshake me-2 text-info"></i> Data Usage
                    </h4>
                    <p class="text-muted">
                        Collected data is used for order tracking, inventory management, and improving operational
                        efficiency. We do not sell or share your information with third parties.
                    </p>

                    <h4 class="fw-semibold text-dark mb-3 mt-4">
                        <i class="fa-solid fa-user-lock me-2 text-warning"></i> Your Rights
                    </h4>
                    <p class="text-muted">
                        You have full control over your data. You can request access, correction, or deletion of
                        your personal information anytime by contacting the administrator.
                    </p>

                    <div class="mt-4 text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                            <i class="fa-solid fa-arrow-left me-2"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
