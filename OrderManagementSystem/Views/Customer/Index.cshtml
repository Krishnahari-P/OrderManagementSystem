@model IEnumerable<Customer>

@{
    ViewData["Title"] = "Home Page";
}

@* <div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div> *@
<div class="modal" id="myModal">
    <div class="modal-dialog">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title">Details of Customer</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Modal body -->
            <div class="modal-body" id="modalContent">
                Modal body..
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

<div class="container py-4">

    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-black">
            <i class="fa-solid fa-users me-2 text-black"></i> Customer Details
        </h2>
        <a asp-action="Create" class="btn btn-success shadow-sm">
            <i class="fa-solid fa-user-plus me-2"></i> Add Customer
        </a>
    </div>

    <!-- Search Section -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body bg-light rounded">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">First Name</label>
                    <input type="text" name="firstName" class="form-control" placeholder="Enter first name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Last Name</label>
                    <input type="text" name="lastName" class="form-control" placeholder="Enter Last name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Phone</label>
                    <input type="text" name="phone" class="form-control" placeholder="Enter Phone Number" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Address</label>
                    <input type="text" name="address" class="form-control" placeholder="Enter address" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="text" name="email" class="form-control" placeholder="Enter email" />
                </div>               
                <div class="col-md-3 d-grid">
                    <input type="submit" class="btn btn-primary rounded-pill shadow-sm" value="Search" />
                </div>
            </form>
        </div>
    </div>

    <!-- Customer Table -->
    <div class="card shadow-lg border-0">
        <div class="card-body">
            <table class="table table-hover align-middle text-center">
                <thead class="table-primary">
                    <tr class="table-primary">
                        <th><i class="fa-solid fa-id-card text-primary me-1"></i> Customer ID</th>
                        <th><i class="fa-solid fa-user text-success me-1"></i> First Name</th>
                        <th><i class="fa-solid fa-user-tag text-success me-1"></i> Last Name</th>
                        <th><i class="fa-solid fa-location-dot text-danger me-1"></i> Address</th>
                        <th><i class="fa-solid fa-phone text-info me-1"></i> Phone</th>
                        <th><i class="fa-solid fa-envelope text-warning me-1"></i> Email</th>
                        <th><i class="fa-solid fa-calendar-days me-2 text-warning"></i> Date Of Creation</th>
                        <th><i class="fa-solid fa-gear"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-muted py-4">
                                <i class="fa-solid fa-circle-exclamation me-2"></i> No customers found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CustomerId</td>
                                <td>@item.FirstName</td>
                                <td>@item.LastName</td>
                                <td>@item.Address</td>
                                <td>@item.Phone</td>
                                <td>@item.Email</td>
                                <td>@item.CreatedDate</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-success btn-sm">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>
                                        @* <a asp-action="Delete" asp-route-id="@item.CustomerId" class="btn btn-outline-danger btn-sm">
                                            <i class="fa-solid fa-trash"></i>
                                        </a> *@
                                        <a href="#" class="Details btn btn-outline-primary btn-sm" data-id="@item.CustomerId">
                                            <i class="fa-solid fa-circle-info"></i>
                                        </a>
                                        <a asp-controller="Order"
                                           asp-action="PlaceOrder"
                                           asp-route-customerId="@item.CustomerId"
                                           class="btn btn-danger btn-sm">
                                            <i class="fa-solid fa-plus me-1"></i> Place Order
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }                   
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function(){
            $(".Details").click(function(){
                var id=$(this).attr("data-id");
                $.ajax({
                    url:"@Url.Action("Detail", "Customer")",
                    type:"GET",
                    data:{"id":id},
                    dataType:"html",
                    success:function(data){
                        $("#modalContent").html(data),
                        $("#myModal").modal("show");

                    },
                    error:function(){
                        alert("Dynamic load failed");
                    },

                })
            });
        });

    </script>
}