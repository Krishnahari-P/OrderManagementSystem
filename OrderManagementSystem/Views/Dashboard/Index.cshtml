        <!-- Purchases -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 text-center transition-all">
                <div class="card-body">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                             style="width:70px; height:70px;">
                            <i class="fa-solid fa-file-invoice-dollar fa-2x text-warning"></i>
                        </div>
                    </div>
                    <h5 class="card-title fw-bold">Purchases</h5>
                    <p class="text-muted small">Track purchase orders and supplier bills.</p>
                    <a asp-controller="Purchase" asp-action="Index" class="btn btn-outline-warning rounded-pill px-4">
                        <i class="fa-solid fa-eye me-2"></i> View
                    </a>
                </div>
            </div>
        </div>

        <!-- Purchase Items -->
        <div class="col">
            <div class="card h-100 border-0 shadow-lg rounded-4 text-center transition-all">
                <div class="card-body">
                    <div class="d-flex justify-content-center mb-3">
                        <div class="bg-secondary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center"
                             style="width:70px; height:70px;">
                            <i class="fa-solid fa-clipboard-check fa-2x text-secondary"></i>
                        </div>
                    </div>
                    <h5 class="card-title fw-bold">Purchase Items</h5>
                    <p class="text-muted small">View individual items in each purchase.</p>
                    <a asp-controller="PurchaseItem" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-eye me-2"></i> View
                    </a>
                </div>
            </div>
        </div>
    </div>
}
