@model PurchaseItem

@{
    ViewData["Title"] = "Detail";
}

<h1>Detail</h1>

<div>
    <h4>PurchaseItem</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseItemId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchaseItemId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UnitCost)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitCost)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PurchaseSet)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PurchaseSet.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ProductSet)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ProductSet.ProductName)
        </dd>
    </dl>
</div>
<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model?.PurchaseItemId" class="btn btn-outline-success btn-sm">
        <i class="fa-solid fa-pen-to-square"></i> Edit
    </a>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fa-solid fa-arrow-left"></i> Back to List
    </a>
</div>