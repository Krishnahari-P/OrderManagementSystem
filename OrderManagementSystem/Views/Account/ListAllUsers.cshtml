@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "ListAllUsers";
}

<div class="container mt-5">
    <h1 class="text-center mb-4 fw-bold" style="color: black;">List of All Users</h1>

    <div class="d-flex justify-content-end mb-3">
        <a asp-action="Register" class="btn btn-success px-4 fw-semibold">+ Create New User</a>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr class="text-center" style="color: black;">
                    <th>@Html.DisplayNameFor(model => model.Id)</th>
                    <th>@Html.DisplayNameFor(model => model.UserName)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="text-center">
                        <td>@Html.DisplayFor(modelItem => item.Id)</td>
                        <td>@Html.DisplayFor(modelItem => item.UserName)</td>
                        <td>
                            <a asp-action="AddOrRemoveRoles" asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm px-3 fw-semibold">
                                Manage Roles
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
