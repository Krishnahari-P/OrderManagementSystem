@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>
<hr />
<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg p-4" style="width: 380px; border-radius: 15px;">
        <div class="text-center mb-4">
            <i class="fa-solid fa-user-lock fa-3x text-primary mb-3"></i>
            <h3 class="fw-bold text-dark">User Login</h3>
            <p class="text-muted">Access your account securely</p>
        </div>

        <form asp-action="Login">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="UserName" class="form-label fw-semibold">
                    <i class="fa-solid fa-user me-2"></i>Username
                </label>
                <input asp-for="UserName" class="form-control form-control-lg" placeholder="Enter your username" />
                <span asp-validation-for="UserName" class="text-danger small"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Password" class="form-label fw-semibold">
                    <i class="fa-solid fa-lock me-2"></i>Password
                </label>
                <input asp-for="Password" type="password" class="form-control form-control-lg" placeholder="Enter your password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-grid">
                <input type="submit" value="Login" class="btn btn-primary btn-lg rounded-pill shadow-sm" />
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
