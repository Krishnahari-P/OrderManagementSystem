@model Purchase

@{
    ViewData["Title"] = "Confirm Payment";
}

<div class="container mt-4">
    <div class="card shadow-lg rounded-4">
        <div class="card-header bg-success text-white text-center">
            <h4 class="mb-0">Confirm Payment</h4>
        </div>
        <div class="card-body">
            <form asp-action="ConfirmPurchasePayment" method="post">
                <input type="hidden" asp-for="PurchaseId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Purchase ID</label>
                    <input asp-for="PurchaseId" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Customer</label>
                    <input class="form-control" value="@Model.SupplierSet?.SupplierName" readonly />

                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Total Amount</label>
                    <input asp-for="TotalAmount" class="form-control" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Payment Method</label>
                    <select name="paymentMethod" class="form-select" required>
                        <option value="">-- Select Payment Method --</option>
                        <option value="Cash">Cash</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="UPI">UPI</option>
                        <option value="Net Banking">Net Banking</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Payment Date</label>
                    <input name="paymentDate" class="form-control" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="d-flex justify-content-center">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="fa-solid fa-check me-2"></i>Confirm Payment
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
