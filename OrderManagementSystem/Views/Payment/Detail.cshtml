@model Payment

@{
    ViewData["Title"] = "Detail";
    Layout = "DetailsLayout";
}

<h1>Detail</h1>

<div>
    <h4>Payment</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.AmountPaid)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.AmountPaid)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentMethod)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentMethod)
        </dd>
    </dl>
</div>
<style>
    dl.row {
        display: flex;
        flex-wrap: wrap;
    }

        dl.row dt {
            flex: 0 0 25% !important;
            font-weight: 600;
            text-align: right;
            padding-right: 10px;
            align-self: center;
        }

        dl.row dd {
            flex: 0 0 70% !important;
            margin: 0 !important;
            align-self: center;
            word-break: break-word;
        }
</style>