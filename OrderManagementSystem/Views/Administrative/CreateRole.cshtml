@model CreateRoleViewModel

@{
    ViewData["Title"] = "Create Role";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4 class="mb-0 fw-bold">Create New Role</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="CreateRole">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="RoleName" class="form-label fw-semibold text-dark"></label>
                            <input asp-for="RoleName" class="form-control form-control-lg rounded-3 shadow-sm" placeholder="Enter role name" />
                            <span asp-validation-for="RoleName" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="ListRoles" class="btn btn-outline-secondary px-4 rounded-pill">
                                ← Back to List
                            </a>
                            <input type="submit" value="Create Role" class="btn btn-primary px-4 rounded-pill fw-semibold" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
