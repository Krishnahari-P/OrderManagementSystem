@model EditRoleViewModel

@{
    ViewData["Title"] = "Delete Role";
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-danger text-white text-center">
            <h4>Delete Role</h4>
        </div>
        <div class="card-body text-center">
            <p class="fw-bold mb-4">Are you sure you want to delete this role?</p>
            <dl class="row">
                <dt class="col-sm-3 text-end">Role ID:</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3 text-end">Role Name:</dt>
                <dd class="col-sm-9">@Model.RoleName</dd>
            </dl>

            <form asp-action="DeleteRole" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RoleName" />
                <button type="submit" class="btn btn-danger px-4">Delete</button>
                <a asp-action="ListRoles" class="btn btn-secondary px-4">Cancel</a>
            </form>
        </div>
    </div>
</div>
