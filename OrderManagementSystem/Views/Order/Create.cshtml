@model Order

@{
    ViewData["Title"] = "Create";
}
@section Styles {
    <link href="~/select2/css/select2.min.css" rel="stylesheet" />
}
<h1>Create</h1>

<h4>Order</h4>
<hr />
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white text-center py-3">
                    <h4 class="mb-0 fw-semibold">
                        <i class="fa-solid fa-box-open me-2"></i> Create New Order
                    </h4>
                </div>

                <!-- Card Body -->
                <div class="card-body bg-light p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold">Customer Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-user me-2 text-success"></i></span>
                                @* <input asp-for="CustomerId" class="form-control" placeholder="Enter Customer ID" /> *@
                                <select asp-for="CustomerId" class="form-select" asp-items="@Model.CustomerList">
                                    <option value="">-- Select Customer --</option>
                                </select>
                            </div>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDate" class="form-label fw-semibold">Date</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-calendar-days me-2 text-warning"></i></span>
                                <input asp-for="OrderDate" class="form-control" placeholder="Enter Date" />
                            </div>
                            <span asp-validation-for="OrderDate" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="TotalAmount" class="form-label fw-semibold">Total Amount</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                                <input asp-for="TotalAmount" class="form-control" placeholder="Total Amount" />
                            </div>
                            <span asp-validation-for="TotalAmount" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Status</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-clipboard-check me-2 text-info"></i></span>
                                <input asp-for="Status" class="form-control" placeholder="Status" />
                            </div>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back
                            </a>
                            <button type="submit" class="btn btn-success rounded-pill px-4">
                                <i class="fa-solid fa-circle-check me-1"></i> Save
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Card Footer -->
                <div class="card-footer bg-white text-center py-3 border-0">
                    <small class="text-muted">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Ensure all fields are filled before saving.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/select2/js/select2.full.min.js"></script>
    <script>
        $(document).ready(function(){
             $('#CustomerId').select2();
        });
    </script>
}
